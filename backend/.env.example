# Copy to backend/.env and edit.
# MySQL (create DB first: CREATE DATABASE pharmacy_shelf CHARACTER SET utf8mb4;)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/pharmacy_shelf?charset=utf8mb4
# For quick local dev without MySQL:
# DATABASE_URL=sqlite:///./pharmacy_shelf.db

CORS_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Dhaka
AUTO_CREATE_TABLES=true

# Scheduler (daily digest)
SCHEDULER_ENABLED=true
DIGEST_HOUR=8
DIGEST_MINUTE=0

# Business rules
SALES_HISTORY_DAYS=120   # days of sales given to ai_engine (365 enables yearly seasonality)
DEFAULT_SNOOZE_DAYS=3
DISMISS_DAYS=30

# Notifications (all off by default)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=owner@example.com,manager@example.com

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMS_ENABLED=false
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TO=01XXXXXXXXX
